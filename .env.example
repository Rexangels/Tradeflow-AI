# Shared
NODE_ENV=development

# API
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tradeflow_ai"
DJANGO_SECRET_KEY="replace-with-a-long-random-secret"
DJANGO_DEBUG="true"
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1"
DJANGO_CORS_ALLOWED_ORIGINS="http://localhost:3000"
DJANGO_ADMIN_EMAIL="admin@tradeflow.local"
DJANGO_ADMIN_PASSWORD="change-me"
GEMINI_API_KEY=""
BINANCE_API_BASE_URL="https://api.binance.us"
MARKET_DATA_CACHE_TTL_SECONDS="60"
# Use strict for research, paper trading, and any broker-connected workflow.
# Synthetic mode is only for interface demos; it cannot run backtests or orders.
MARKET_DATA_FALLBACK_MODE="strict"

# Optional real-data / execution providers. Never commit actual credentials.
ALPACA_API_KEY=""
ALPACA_API_SECRET=""
ALPACA_MODE="paper"
MT5_LOGIN=""
MT5_PASSWORD=""
MT5_SERVER=""
MT5_PATH=""

# Web
VITE_API_BASE_URL="http://localhost:4000"
